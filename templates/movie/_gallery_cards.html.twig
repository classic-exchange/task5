{% for movie in movies %}
	<div class="col-md-4">
		<div class="card h-100">
			<div class="card-body">
				<div class="text-muted mb-1">
					#{{ movie.index }}
				</div>
				<h4>
					{{ movie.title }}
				</h4>
				<p class="text-muted">
					{{ movie.year }}
					·
					{{ movie.genre }}
				</p>
				<p>
					<strong>Cast:</strong>
					{{ movie.actors|join(', ') }}
				</p>
				<p>
					<strong>Likes:</strong>
					{{ movie.likes }}
				</p>
				<div class="trailer" data-trailer="{{ movie.trailer|json_encode|e('html_attr') }}">
					<div class="trailer-preview">
						<video class="trailer-preview-video" src="/trailer/clips/{{ movie.trailer.preview.clip }}#t={{ movie.trailer.preview.start }}" muted preload="metadata"></video>
						<div class="trailer-preview-title">
							{{ movie.title }}
						</div>
						<button type="button" class="trailer-play btn btn-dark">
							<i class="bi bi-play-fill"></i>
							Watch trailer
						</button>
					</div>
					<div class="trailer-player" hidden>
						<video class="trailer-video" muted playsinline></video>
						<div class="trailer-text"></div>
					</div>
				</div>
				<details class="mt-3">
					<summary>
						Reviews ({{ movie.reviews|length }})
					</summary>
					<div class="mt-2">
						{% if movie.reviews is empty %}
							<p class="text-muted">
								No reviews
							</p>
						{% else %}
							{% for review in movie.reviews %}
								<p>
									{{ review }}
								</p>
							{% endfor %}
						{% endif %}
					</div>
				</details>
			</div>
		</div>
	</div>
{% endfor %}
